<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fractalmem-mcp</AssemblyName>
    <PackageId>FractalMemory.McpServer</PackageId>
    <Description>FractalMem stdio MCP server for exposing local structured memory to agent clients.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fractalmem-mcp</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FractalMemory.Core\FractalMemory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
